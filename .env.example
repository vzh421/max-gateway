# Скопировать в .env и заполнить. .env в git не коммитится.
# Комментарии — только отдельными строками.

# --- Защитные правила (значения по умолчанию — безопасные) ---
# true — ничего не отправлять, только журнал. Боевой режим — только явно (false).
DRY_RUN=true
REPLY_TO_UNKNOWN=false
# Перенаправление в бот: первая ссылка + до 3 мягких напоминаний, не чаще раза в 24 ч, окно 30 дн.
REDIRECT_MIN_INTERVAL_HOURS=24
REDIRECT_MAX_REMINDERS=3
REDIRECT_WINDOW_DAYS=30
MAX_REPLIES_PER_HOUR=10
REPLY_DELAY_SEC=20-90
# true — запрет любых отправок с личного аккаунта (есть ещё файл-флаг: python -m gateway kill on)
KILL_SWITCH=false
# MARK_READ не поддерживается: чаты прочитанными не отмечаются никогда.

# --- Личный аккаунт MAX ---
MAX_PHONE=+7XXXXXXXXXX

# --- БД (docker compose) ---
POSTGRES_PASSWORD=change-me-long-random

# --- Токены привязки ---
TOKEN_TTL_DAYS=14

# --- ai4au (только чтение) ---
AI4AU_BASE_URL=https://ai4au.ru
AI4AU_API_TOKEN=

# --- Официальный бот (отдельная сессия; контракт — docs/bot-integration.md) ---
# Ник бота для ссылки https://max.ru/<BOT_USERNAME>?start=<токен>
BOT_USERNAME=
# Ключ, с которым бот обращается к /bot-api/* шлюза (заголовок X-Api-Key)
BOT_API_KEY=
# Эндпоинт бота для уведомлений управляющему и ключ к нему; пусто — уведомления в лог
BOT_NOTIFY_URL=
BOT_NOTIFY_KEY=
# Несрочные уведомления — сводкой раз в N минут
NOTIFY_DIGEST_MINUTES=60

# --- Контакты телефона: Google Контакты, только чтение (docs/contacts.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Автосинхронизация раз в N часов; 0 — только вручную
CONTACTS_SYNC_HOURS=24

# --- Служебный API (порт только на 127.0.0.1 сервера) ---
GATEWAY_API_PORT=8090
# Пусто — админ-эндпоинты выключены
ADMIN_TOKEN=

# --- Тексты: утверждает управляющий ---
# Пока в тексте есть «[НЕ УТВЕРЖДЕНО]», боевая отправка запрещена. {link} — место ссылки на бот.
# Текст разбирается как markdown: *, _, ~, ` меняют начертание; ссылка вставляется автоматически.
REDIRECT_FIRST_TEMPLATE="[НЕ УТВЕРЖДЕНО] Первое перенаправление в бот: {link}"
REDIRECT_REMINDER_TEMPLATE="[НЕ УТВЕРЖДЕНО] Мягкое напоминание про бот: {link}"

LOG_LEVEL=INFO
